import discord from discord.ext import commands from config import token # İzinleri ayarla intents = discord.Intents.default() intents.message_content = True # Bot ön ekini (!) ve izinleri tanımla client = commands.Bot(command_prefix='!', intents=intents) @client.event async def on_ready(): print(f'Giriş yaptı: {client.user}') @client.event async def on_message(message): if message.author == client.user: return # Bu satır olmadan @client.command() komutları ÇALIŞMAZ await client.process_commands(message) @client.command() async def about(ctx): await ctx.send('Bu discord.py kütüphanesi ile oluşturulmuş echo-bot!') # Toplama Komutu @client.command() async def add(ctx, sayi1: int, sayi2: int): await ctx.send(f'{sayi1 + sayi2}') # Botu çalıştır client.run(token)
